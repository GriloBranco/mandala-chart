# Copy to .env.local for local development. Everything is optional locally.

# Signs the login cookie. Required in production: 32+ random characters, e.g. openssl rand -base64 32.
# Changing it signs everyone out.
SESSION_SECRET=

# Database. Local development always uses a SQLite file (local.db), even if these are set,
# unless MANDALA_REMOTE_DB=1. In production the Vercel Turso integration sets both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. Turns on AI suggestions, leverage analysis and voice reports.
# Use a key from a billing-enabled Google Cloud project so prompts are not used for training.
GEMINI_API_KEY=

# Optional. Overrides the default model (gemini-3.8-flash).
GEMINI_MODEL=

# Optional. Invite-only sign-up: new accounts must enter this code. Use a random code, not a word,
# e.g. openssl rand -base64 12 (the setup script offers one). Each network gets 10 tries an hour.
SIGNUP_CODE=

# Optional. Set to 1 to stop new accounts.
SIGNUPS_CLOSED=

# Optional daily AI limits (defaults: 60 per person, 15 report analyses per person, 1500 in total).
# 0 turns that AI off: AI_DAILY_LIMIT=0 stops suggestions, Sharpen and Leverage, REPORT_DAILY_LIMIT=0
# stops report analysis, and AI_GLOBAL_DAILY_LIMIT=0 turns all AI off for everyone.
AI_DAILY_LIMIT=
REPORT_DAILY_LIMIT=
AI_GLOBAL_DAILY_LIMIT=

# Sign-in, sign-up, password checks and API requests have fixed limits. See Limits in README.md.
