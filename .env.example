# Copy to .env.local for local development. Everything is optional locally.

# Signs the login cookie. Required in production: 32+ random characters, e.g. openssl rand -base64 32.
# Changing it signs everyone out.
SESSION_SECRET=

# Database. Local development always uses a SQLite file (local.db), even if these are set,
# unless MANDALA_REMOTE_DB=1. In production the Vercel Turso integration sets both.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. Invite-only sign-up: new accounts must enter this code. Use a random code, not a word,
# e.g. openssl rand -base64 12 (the setup script offers one). Each network gets 10 tries an hour.
SIGNUP_CODE=

# Optional. Set to 1 to stop new accounts.
SIGNUPS_CLOSED=

# Optional. Todoist sync: the Client ID and Client secret of your app in Todoist's App Management
# Console (see Todoist in README.md). Without them the account page does not offer Todoist.
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Optional. Encrypts the Todoist tokens kept in the database: 32 random bytes in base64,
# e.g. openssl rand -base64 32. Without it the key comes from SESSION_SECRET. Changing the key
# (or SESSION_SECRET while this is empty) means everyone has to connect Todoist again.
TODOIST_TOKEN_KEY=

# Needed with Todoist. Vercel Cron sends it to the daily Todoist job, which refuses calls without
# it. Any long random string, e.g. openssl rand -base64 32.
CRON_SECRET=

# Sign-in, sign-up, password checks and API requests have fixed limits. See Limits in README.md.
